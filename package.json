{
  "name": "quitsmoke-bot",
  "version": "2.0.0",
  "description": "Telegram bot + REST API to help quit smoking (cigarettes, IQOS, vapes)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "bot": "tsx src/index.ts",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/static": "^9.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.9.0",
    "canvas": "^3.2.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "grammy": "^1.42.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
